# Copy this file to .env and fill in real values before running
# docker compose up, or before starting api/worker locally.
# Never commit the real .env — it's already in .gitignore.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# ---------------------------------------------------------------------------
# Database (Postgres 16). Local docker-compose sets this automatically for
# the api/worker containers — only needed here for running outside Docker
# (e.g. `npm run dev:api` against `docker compose up postgres`).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://syncrank:syncrank_dev_password@localhost:5432/syncrank

# ---------------------------------------------------------------------------
# Redis 7 — BullMQ queues, rate limiting, contest event pub/sub.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-real-random-secret-at-least-32-chars-long
# Set to true in production (requires HTTPS — cookies won't be sent over
# plain HTTP with Secure set).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# CORS / frontend origin — must match exactly where the web app is served.
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Codeforces sync
# ---------------------------------------------------------------------------
CF_API_BASE_URL=https://codeforces.com/api
# Minimum ms between CF API calls, process-wide. CF asks integrators to stay
# under ~1 req/sec; 2000ms is a conservative default.
CF_REQUEST_DELAY_MS=2000

# ---------------------------------------------------------------------------
# FIXTURE_MODE — when true, LeetCode sync always uses deterministic fixture
# data instead of hitting the real (unofficial, frequently-blocked)
# GraphQL endpoint. Useful for demos, CI, and local dev where you don't want
# flaky results depending on whether LeetCode is currently blocking your IP.
#
# NEVER set this to true in a real production deployment serving real users
# — they'd see fake solve counts. Production default is false.
# ---------------------------------------------------------------------------
FIXTURE_MODE=false

# ---------------------------------------------------------------------------
# Worker-only: how often (ms) the worker polls for contest lifecycle
# transitions (scheduled -> live -> completed).
# ---------------------------------------------------------------------------
CONTEST_LIFECYCLE_POLL_MS=30000

# ---------------------------------------------------------------------------
# Frontend build-time (Vite inlines these into the static bundle — they are
# NOT runtime env vars once built, so the frontend must be rebuilt if this
# changes).
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
